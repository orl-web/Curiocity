# CurioCity Web — environment variables
# Copy to apps/web/.env (or set in Vercel/Netlify dashboard). Never commit .env.

# Base URL of the API. Leave empty in dev (Vite proxy handles /api → localhost:3001).
# In production set to your full API origin, e.g. https://api.curiocity.app/api
VITE_API_URL=

# Sentry DSN (optional). Leave empty to disable.
VITE_SENTRY_DSN=
