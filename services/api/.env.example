# CurioCity API — environment variables
# Copy to services/api/.env and fill in real values. Never commit .env.

# --- Core ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# --- Database (required) ---
# Local Docker: postgresql://wanderwise:wanderwise123@localhost:5432/curiocity
# Production: use your managed Postgres connection string with sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/curiocity

# --- Auth (required) ---
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-another-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGIN=http://localhost:3002,http://localhost:5173

# --- Stripe (payments) ---
# Dashboard → Developers → API Keys (test keys first: sk_test_... / pk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Dashboard → Developers → Webhooks → signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Dashboard → Settings → Connect → Express onboarding client ID
STRIPE_CONNECT_CLIENT_ID=
# Platform commission percentage (e.g. 30)
PLATFORM_FEE_PERCENT=30

# --- Storage (Cloudflare R2 or AWS S3) ---
# R2 is S3-compatible: create an R2 bucket + API token, set region to "auto"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=curiocity-uploads
S3_CDN_URL=

# --- AI (Anthropic) ---
# console.anthropic.com → API Keys. Add $5-10 of credits to start.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AI_RATE_LIMIT_PER_HOUR=10

# --- Email (SendGrid) ---
# app.sendgrid.com → Settings → API Keys. Sender must be verified.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@curiocity.app

# --- Geocoding ---
# "nominatim" (free, default) or "google"
GEOCODING_PROVIDER=nominatim
NOMINATIM_EMAIL=
GOOGLE_GEOCODING_API_KEY=
GEOCODING_CACHE_TTL_DAYS=30

# --- Monitoring (optional) ---
# sentry.io → Project → DSN. Leave empty to disable Sentry.
SENTRY_DSN=

# --- Push notifications (optional, future) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@curiocity.app

# --- Referrals / payouts (optional tuning) ---
REFERRAL_CREDIT_AMOUNT=0.50
CREATOR_PAYOUT_THRESHOLD=50

# --- Ads (optional, ad-unlocked guides) ---
ADMOB_AD_UNIT_ID=
ADMOB_APP_ID=
UNITY_AD_GAME_ID=

# --- Social login (optional, future) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Analytics (optional) ---
MIXPANEL_TOKEN=
AMPLITUDE_API_KEY=

# --- Firebase (optional, push) ---
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
